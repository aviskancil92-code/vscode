    <string name="app_name">CodeX Studio</string>
    <string name="tagline">Debian + code-server di Android — tanpa root</string>

    <!-- Setup -->
    <string name="setup_description">Aplikasi ini menjalankan sistem Debian GNU/Linux lengkap bersama code-server (VS Code di peramban) di latar belakang perangkat Anda, lalu menampilkannya langsung di dalam aplikasi.\n\nSemua komponen diunduh saat instalasi pertama: APK tetap kecil, sistem lengkap terpasang di penyimpanan aplikasi.</string>
    <string name="download_plan_title">Rencana unduhan (sekali saja)</string>
    <string name="download_plan">• proot + library     ±0,4 MB\n• rootfs Debian 12    ±90 MB\n• code-server + Node  ±215 MB\n\nTotal ruang terpasang: ±1 GB</string>
